# Copy this file to .env and fill in real values before running the server.
# `npm run dev` / `npm start` will exit immediately if any required
# variable (see config/env.js -> validateRequiredEnv) is missing.

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database ------------------------------------------------------------
# MongoDB connection string (Atlas or local).
MONGO_URI=mongodb://localhost:27017/tronschool


# --- Cloudinary (file/image uploads) ----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT Auth ----------------------------------------------------------
JWT_SECRET=
# Use long, random strings in production (e.g. `openssl rand -hex 64`).
ACCESS_TOKEN_SECRET=
# Duration formats accepted: plain seconds ("900"), or <number><unit>
# where unit is one of ms|s|m|h|d|w, e.g. "15m", "7d".
ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# --- CSRF ----------------------------------------------------------------
# Optional: falls back to ACCESS_TOKEN_SECRET if not set. Set a dedicated
# secret in production.
CSRF_SECRET=

CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173, yourDomain.com

# Base URL used in email links (verification, password reset).
# Defaults to the first CLIENT_ORIGINS entry if not set.
EMAIL_URL=https://your-domain.com

REDIS_URL=your redis url

# --- Brevo (transactional email) ----------------------------------------
# Get your API key from app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
BREVO_SENDER_NAME=TronSchool
BREVO_SENDER_EMAIL=